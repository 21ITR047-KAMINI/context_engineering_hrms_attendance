{
  "version": "2.0",
  "purpose": "Production-ready HRMS schema metadata for RAG-based table, column, and join retrieval for one-agent dynamic SQL generation and reasoning.",
  "notes": [
    "Keep actual SQL table names exactly as they exist in the database.",
    "This file is the schema knowledge base: table names, column names, descriptions, domains, join hints, and use cases.",
    "Business interpretation such as W = week off, P = permission, F = full day leave, or no-row = working day belongs in business_rules.py, not here.",
    "Selectors and prompt builders should prefer the minimum required tables and columns for each query.",
    "Operational status tables should generally be preferred over descriptive/reference tables for factual user questions."
  ],
  "tables": {
    "login_mast": {
      "domain": "attendance",
      "description": "Stores employee login and logout attendance records and attendance-related operational values.",
      "primary_keys": ["id"],
      "business_keys": ["emp_id", "login_date"],
      "columns": {
        "id": "Internal identifier for the attendance record",
        "emp_id": "Employee identifier",
        "login_date": "Attendance date",
        "login_time": "Login time or punch-in time",
        "logoff_time": "Logout time or punch-out time",
        "shift_code": "Shift code for the attendance record",
        "Logintype": "Type of login such as biometric, WFH, or leave-shift",
        "isLateComing": "Flag indicating whether the employee was late",
        "shiftWorkingMinutes": "Expected working minutes for the assigned shift",
        "actualWorkingMinutes": "Actual worked minutes calculated from punches"
      },
      "used_for": [
        "attendance lookup",
        "daily attendance lookup",
        "login logout queries",
        "worked hours queries",
        "worked minutes queries",
        "late attendance reasoning",
        "punch-based attendance details"
      ],
      "join_hints": [
        "login_mast.emp_id = emp_leave_setting.emp_id",
        "login_mast.login_date = emp_leave_setting.leave_date",
        "login_mast.shift_code = shift_details.shift_code",
        "login_mast.emp_id = emp_default_shift.emp_id",
        "login_mast.emp_id = cl_detail.emp_id"
      ]
    },

